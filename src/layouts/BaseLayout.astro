---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Vinod Kumar - Data & AI Architect" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --color-bg: #ffffff;
        --color-text: #0f0f0f;
        --color-text-light: #555;
        --color-border: #ddd;
        --color-accent: #0066cc;
        --color-accent-dark: #0052a3;
        --color-success: #28a745;
        --color-bg-light: #f5f5f5;
        --space-xs: 0.5rem;
        --space-sm: 1rem;
        --space-md: 1.5rem;
        --space-lg: 2rem;
        --space-xl: 3rem;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --color-bg: #0f0f0f;
          --color-text: #f5f5f5;
          --color-text-light: #b0b0b0;
          --color-border: #333;
          --color-bg-light: #1f1f1f;
        }
      }

      html[data-theme="dark"] {
        --color-bg: #0f0f0f;
        --color-text: #f5f5f5;
        --color-text-light: #b0b0b0;
        --color-border: #333;
        --color-bg-light: #1f1f1f;
      }

      html[data-theme="light"] {
        --color-bg: #ffffff;
        --color-text: #0f0f0f;
        --color-text-light: #555;
        --color-border: #ddd;
        --color-bg-light: #f5f5f5;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }

      header {
        border-bottom: 1px solid var(--color-border);
        padding: var(--space-md) 0;
        position: sticky;
        top: 0;
        background-color: var(--color-bg);
        z-index: 100;
      }

      nav {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
        color: var(--color-accent);
      }

      .nav-links {
        display: flex;
        gap: var(--space-lg);
        list-style: none;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.95rem;
        transition: color 0.2s;
      }

      .nav-links a:hover {
        color: var(--color-accent);
      }

      .theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.3rem;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background-color 0.3s ease;
      }

      .theme-toggle:hover {
        background-color: var(--color-bg-light);
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: var(--space-lg);
      }

      footer {
        border-top: 1px solid var(--color-border);
        padding: var(--space-xl) var(--space-lg);
        margin-top: var(--space-xl);
        text-align: center;
        color: var(--color-text-light);
        font-size: 0.9rem;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      button, .btn {
        display: inline-block;
        padding: var(--space-sm) var(--space-md);
        background-color: var(--color-accent);
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.2s;
        text-decoration: none;
      }

      button:hover, .btn:hover {
        background-color: var(--color-accent-dark);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href="/my_portfolio/" class="logo">Vinod Kumar KP</a>
        <ul class="nav-links">
          <li><a href="/my_portfolio/">Home</a></li>
          <li><a href="/my_portfolio/projects">Projects</a></li>
          <li><a href="/my_portfolio/about">About</a></li>
          <li>
            <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
              <span id="theme-icon">🌙</span>
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <script>
      // Dark mode toggle
      const themeToggle = document.getElementById('theme-toggle');
      const themeIcon = document.getElementById('theme-icon');
      const html = document.documentElement;

      // Check for saved theme preference or default to system preference
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const initialTheme = savedTheme || (prefersDark ? 'dark' : 'light');

      function setTheme(theme) {
        if (theme === 'dark') {
          html.setAttribute('data-theme', 'dark');
          themeIcon.textContent = '☀️';
          localStorage.setItem('theme', 'dark');
        } else {
          html.setAttribute('data-theme', 'light');
          themeIcon.textContent = '🌙';
          localStorage.setItem('theme', 'light');
        }
      }

      // Set initial theme
      setTheme(initialTheme);

      // Toggle on button click
      themeToggle?.addEventListener('click', () => {
        const currentTheme = localStorage.getItem('theme') || (prefersDark ? 'dark' : 'light');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
      });
    </script>

    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 Vinod Kumar. All rights reserved.</p>
      <p style="margin-top: 0.5rem; font-size: 0.85rem;">Generated using <a href="https://github.com/VinodKumarKP/portfolio_builder" target="_blank" rel="noopener noreferrer">Portfolio Builder</a></p>
    </footer>
  </body>
</html>
