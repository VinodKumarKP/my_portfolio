---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vinod Kumar - Data & AI Architect">
  <style>
    .hero {
      text-align: center;
      margin: var(--space-xl) 0;
    }

    .hero h1 {
      font-size: 2.5rem;
      margin-bottom: var(--space-md);
      line-height: 1.2;
    }

    .hero .subtitle {
      font-size: 1.25rem;
      color: var(--color-text-light);
      margin-bottom: var(--space-lg);
    }

    .cta-buttons {
      display: flex;
      gap: var(--space-md);
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: var(--space-xl);
    }

    .cta-buttons a {
      padding: var(--space-sm) var(--space-lg);
      background-color: var(--color-accent);
      color: white;
      border-radius: 4px;
      font-weight: 500;
      transition: background-color 0.2s;
    }

    .cta-buttons a:hover {
      background-color: var(--color-accent-dark);
      text-decoration: none;
    }

    .timeline {
      max-width: 800px;
      margin: var(--space-xl) auto;
    }

    .timeline h2 {
      text-align: center;
      margin-bottom: var(--space-lg);
      font-size: 1.75rem;
    }

    .timeline-container {
      position: relative;
      padding: var(--space-lg) 0;
    }

    .timeline-container::before {
      content: '';
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 4px;
      height: 100%;
      background: linear-gradient(to bottom, transparent, var(--color-accent), #8a2be2, transparent);
      border-radius: 2px;
    }

    .timeline-item {
      margin-bottom: var(--space-xl);
      position: relative;
    }

    .timeline-item:nth-child(odd) .content {
      margin-left: 0;
      margin-right: 55%;
      text-align: right;
    }

    .timeline-item:nth-child(even) .content {
      margin-left: 55%;
      margin-right: 0;
      text-align: left;
    }

    .timeline-dot {
      position: absolute;
      left: 50%;
      top: 1.5rem;
      width: 20px;
      height: 20px;
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      border: 4px solid var(--color-bg);
      border-radius: 50%;
      transform: translateX(-50%);
      z-index: 1;
      box-shadow: 0 0 0 4px rgba(0, 102, 204, 0.1);
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .timeline-item:hover .timeline-dot {
      transform: translateX(-50%) scale(1.4);
      box-shadow: 0 0 15px rgba(138, 43, 226, 0.6);
    }

    .content {
      padding: 2rem;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.3) 100%);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.4);
      border-radius: 16px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
      position: relative;
    }
    @media (prefers-color-scheme: dark) {
      .content {
        background: linear-gradient(135deg, rgba(40, 40, 40, 0.8) 0%, rgba(20, 20, 20, 0.5) 100%);
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
    }
    
    .timeline-item:nth-child(odd):hover .content {
      transform: translateX(-10px) translateY(-5px);
      box-shadow: 0 20px 50px rgba(0, 102, 204, 0.25), inset 0 0 20px rgba(0, 102, 204, 0.1);
      border-color: rgba(0, 102, 204, 0.5);
    }
    .timeline-item:nth-child(even):hover .content {
      transform: translateX(10px) translateY(-5px);
      box-shadow: 0 20px 50px rgba(138, 43, 226, 0.25), inset 0 0 20px rgba(138, 43, 226, 0.1);
      border-color: rgba(138, 43, 226, 0.5);
    }

    .year {
      font-weight: 800;
      font-size: 1.5rem;
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.5rem;
    }

    .phase-title {
      font-weight: 700;
      font-size: 1.2rem;
      margin-bottom: var(--space-xs);
      color: var(--color-text);
    }

    .phase-desc {
      color: var(--color-text-light);
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .timeline-project-link {
      display: inline-flex;
      align-items: center;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-accent);
      text-decoration: none;
      background: rgba(0, 102, 204, 0.05);
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid rgba(0, 102, 204, 0.2);
      transition: all 0.3s ease;
    }

    .timeline-project-link:hover {
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      color: white;
      text-decoration: none;
      box-shadow: 0 5px 15px rgba(138, 43, 226, 0.3);
    }
    
    .timeline-item:nth-child(odd) .timeline-project-link:hover {
      transform: translateX(-5px);
    }
    .timeline-item:nth-child(even) .timeline-project-link:hover {
      transform: translateX(5px);
    }

    .metrics {
      margin-top: var(--space-xl);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-lg);
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .metric {
      text-align: center;
      padding: var(--space-md);
      background-color: var(--color-bg-light);
      border: 1px solid var(--color-border);
      border-radius: 4px;
    }

    .metric-number {
      font-size: 2rem;
      font-weight: 700;
      color: var(--color-accent);
    }

    .metric-label {
      color: var(--color-text-light);
      font-size: 0.9rem;
      margin-top: var(--space-xs);
    }

    .metric-icon {
      font-size: 2rem;
      margin-bottom: 0.75rem;
    }

    .current-focus-badge {
      display: inline-block;
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      color: white;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      margin-left: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      animation: pulse-glow 2s ease-in-out infinite;
    }

    @keyframes pulse-glow {
      0%, 100% {
        box-shadow: 0 0 10px rgba(138, 43, 226, 0.5);
      }
      50% {
        box-shadow: 0 0 20px rgba(138, 43, 226, 0.8);
      }
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 1.75rem;
      }

      .hero .subtitle {
        font-size: 1rem;
      }

      .timeline-container::before {
        left: 16px;
      }

      .timeline-dot {
        left: 16px;
      }

      .timeline-item:nth-child(odd) .content,
      .timeline-item:nth-child(even) .content {
        margin-left: 60px;
        margin-right: 0;
        text-align: left;
      }

      .cta-buttons {
        flex-direction: column;
        align-items: center;
      }

      .cta-buttons a {
        width: 100%;
        max-width: 300px;
      }
    }
  </style>

  <div class="hero">
    <h1>Architect & AI Engineer</h1>
    <p class="subtitle">18+ years building data pipelines, cloud infrastructure, and AI systems at scale</p>
    <div class="cta-buttons">
      <a href="/my_portfolio/projects">Explore Projects</a>
      <a href="/my_portfolio/about">Learn More</a>
    </div>
  </div>

  <div class="timeline">
    <h2>My Journey from Data Engineer to AI Architect</h2>
    <div class="timeline-container">
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="content">
          <div class="year">2007</div>
          <div class="phase-title">ASP.NET Developer</div>
          <div class="phase-desc">Started my first project building scalable UI architecture.</div>
          <a href="/my_portfolio/projects/enterprise-tokenization-ui/" class="timeline-project-link">View Project: Enterprise Tokenization UI →</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="content">
          <div class="year">2012</div>
          <div class="phase-title">Data Engineer</div>
          <div class="phase-desc">Architected generic, metadata-driven ETL pipelines.</div>
          <a href="/my_portfolio/projects/generic-etl-process/" class="timeline-project-link">View Project: Generic ETL Framework →</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="content">
          <div class="year">2018</div>
          <div class="phase-title">Cloud / Data Architect</div>
          <div class="phase-desc">Architected fully event-driven, cost-optimized big data pipelines.</div>
          <a href="/my_portfolio/projects/on-premise-to-cloud/" class="timeline-project-link">View Project: AWS Migration →</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="content">
          <div class="year">2019</div>
          <div class="phase-title">DevOps / Data Engineer</div>
          <div class="phase-desc">Large scale migrations and Kubernetes architectures.</div>
          <a href="/my_portfolio/projects/control-m-to-airflow/" class="timeline-project-link">View Project: Control-M to Airflow →</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="content">
          <div class="year">2023</div>
          <div class="phase-title">DevOps / Release Architect</div>
          <div class="phase-desc">Engineered polyglot build orchestrations and CI/CD pipelines.</div>
          <a href="/my_portfolio/projects/pipeline-factory/" class="timeline-project-link">View Project: Jenkins Pipeline Factory →</a>
          <a href="/my_portfolio/projects/gated-ci-cd-pipelines/" class="timeline-project-link" style="margin-top: 8px;">View Project: Gated CI/CD & Testing →</a>
          <a href="/my_portfolio/projects/observability-secret-management/" class="timeline-project-link" style="margin-top: 8px;">View Project: Enterprise Security & Splunk →</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="content">
          <div class="year">2024</div>
          <div class="phase-title">DevOps / Release Architect</div>
          <div class="phase-desc">Idempotent migration of 250+ Jenkins pipelines to CloudBees CI.</div>
          <a href="/my_portfolio/projects/jenkins-to-cloudbees/" class="timeline-project-link">View Project: CloudBees Migration →</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="content">
          <div class="year">2025 Onwards<span class="current-focus-badge">Current Focus</span></div>
          <div class="phase-title">AI/GenAI Engineer & Architect</div>
          <div class="phase-desc">LLM agents, RAG systems, agentic platforms, AI Champion award.</div>
          <a href="/my_portfolio/projects/copilot-agents-extension/" class="timeline-project-link">View Project: Copilot VS Code Extension →</a>
          <a href="/my_portfolio/projects/jira-release-orchestration/" class="timeline-project-link" style="margin-top: 8px;">View Project: Release Orchestration →</a>
          <a href="/my_portfolio/projects/agent-development-kit/" class="timeline-project-link" style="margin-top: 8px;">View Project: Agent Development Kit (ADK) →</a>
          <a href="/my_portfolio/projects/enterprise-ai-platform/" class="timeline-project-link" style="margin-top: 8px;">View Project: Enterprise AI Platform →</a>
          <a href="/my_portfolio/projects/release-management-agent/" class="timeline-project-link" style="margin-top: 8px;">View Project: Autonomous Release Agent →</a>
        </div>
      </div>
    </div>
  </div>

  <div class="metrics">
    <div class="metric">
      <div class="metric-icon">💻</div>
      <div class="metric-number">18+</div>
      <div class="metric-label">Years of Software Engineering</div>
    </div>
    <div class="metric">
      <div class="metric-icon">📜</div>
      <div class="metric-number">10+</div>
      <div class="metric-label">Industry Certifications</div>
    </div>
    <div class="metric">
      <div class="metric-icon">🏆</div>
      <div class="metric-number">4</div>
      <div class="metric-label">Awards & Recognitions</div>
    </div>
  </div>
</BaseLayout>
