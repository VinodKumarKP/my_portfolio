---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects">
  <style>
    .projects-intro {
      text-align: center;
      margin-bottom: var(--space-xl);
    }

    .projects-intro h1 {
      font-size: 2rem;
      margin-bottom: var(--space-md);
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: var(--space-lg);
    }

    .project-card {
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: var(--space-lg);
      background-color: var(--color-bg-light);
      transition: all 0.3s ease;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
    }

    .project-card:hover {
      border-color: var(--color-accent);
      box-shadow: 0 4px 12px rgba(0, 102, 204, 0.1);
      transform: translateY(-2px);
    }

    .project-card-header {
      margin-bottom: var(--space-md);
    }

    .project-card-year {
      font-size: 0.85rem;
      color: var(--color-accent);
      font-weight: 600;
      margin-bottom: var(--space-xs);
    }

    .project-card-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-sm);
    }

    .project-card-phase {
      font-size: 0.9rem;
      color: var(--color-text-light);
      margin-bottom: var(--space-md);
    }

    .project-card-description {
      flex-grow: 1;
      margin-bottom: var(--space-md);
      line-height: 1.6;
    }

    .project-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .tag {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      background-color: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 3px;
      font-size: 0.8rem;
      color: var(--color-text-light);
    }

    @media (max-width: 768px) {
      .projects-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="projects-intro">
    <h1>Projects & Case Studies</h1>
    <p>Detailed project case studies showcasing architecture, challenges, and impact</p>
  </div>

  <div class="projects-grid">
    <a href="/portfolio/projects/control-m-to-airflow/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2019</div>
        <h2 class="project-card-title">Control-M to Apache Airflow Migration</h2>
        <div class="project-card-phase">DevOps / Data Engineer</div>
      </div>
      <p class="project-card-description">
        Migrated 500+ legacy batch jobs from Control-M to Apache Airflow on Kubernetes, reducing release cycle from 2 weeks to 3 days and eliminating 60% of manual operations.
      </p>
      <div class="project-card-tags">
        <span class="tag">Airflow</span>
        <span class="tag">Kubernetes</span>
        <span class="tag">Python</span>
        <span class="tag">GitLab CI/CD</span>
      </div>
    </a>

    <!-- Placeholder for additional projects -->
    <div class="project-card" style="opacity: 0.5; pointer-events: none;">
      <div class="project-card-header">
        <div class="project-card-year">Coming Soon</div>
        <h2 class="project-card-title">Cloud-Native Microservices Platform</h2>
        <div class="project-card-phase">Solutions Architect</div>
      </div>
      <p class="project-card-description">
        Designed and built a microservices platform with FastAPI, EKS, and ArgoCD...
      </p>
      <div class="project-card-tags">
        <span class="tag">FastAPI</span>
        <span class="tag">EKS</span>
        <span class="tag">Python</span>
      </div>
    </div>

    <div class="project-card" style="opacity: 0.5; pointer-events: none;">
      <div class="project-card-header">
        <div class="project-card-year">Coming Soon</div>
        <h2 class="project-card-title">Agent Development Kit (ADK)</h2>
        <div class="project-card-phase">AI Engineer</div>
      </div>
      <p class="project-card-description">
        Built a framework-agnostic agent platform where one YAML runs agents on LangChain, LangGraph, CrewAI...
      </p>
      <div class="project-card-tags">
        <span class="tag">LLM Agents</span>
        <span class="tag">Python</span>
        <span class="tag">FastAPI</span>
      </div>
    </div>
  </div>
</BaseLayout>
