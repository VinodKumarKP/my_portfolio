---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects">
  <style>
    .projects-intro {
      text-align: center;
      margin-bottom: var(--space-xl);
    }

    .projects-intro h1 {
      font-size: 2rem;
      margin-bottom: var(--space-md);
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: var(--space-lg);
    }

    .project-card {
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: var(--space-lg);
      background-color: var(--color-bg-light);
      transition: all 0.3s ease;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
    }

    .project-card:hover {
      border-color: var(--color-accent);
      box-shadow: 0 4px 12px rgba(0, 102, 204, 0.1);
      transform: translateY(-2px);
    }

    .project-card-header {
      margin-bottom: var(--space-md);
    }

    .project-card-year {
      font-size: 0.85rem;
      color: var(--color-accent);
      font-weight: 600;
      margin-bottom: var(--space-xs);
    }

    .project-card-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-sm);
    }

    .project-card-phase {
      font-size: 0.9rem;
      color: var(--color-text-light);
      margin-bottom: var(--space-md);
    }

    .project-card-description {
      flex-grow: 1;
      margin-bottom: var(--space-md);
      line-height: 1.6;
    }

    .project-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .tag {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      background-color: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 3px;
      font-size: 0.8rem;
      color: var(--color-text-light);
    }

    @media (max-width: 768px) {
      .projects-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="projects-intro">
    <h1>Projects & Case Studies</h1>
    <p>Detailed project case studies showcasing architecture, challenges, and impact</p>
  </div>

  <div class="projects-grid">
    <a href="/my_portfolio/projects/copilot-agents-extension/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2026</div>
        <h2 class="project-card-title">Enterprise Copilot Agents & VS Code Extension</h2>
        <div class="project-card-phase">AI/GenAI Engineer & Architect</div>
      </div>
      <p class="project-card-description">
        Engineered 58 specialized GenAI agents and distributed them via a custom VS Code extension to drive enterprise AI adoption and eliminate code duplication.
      </p>
      <div class="project-card-tags">
        <span class="tag">GenAI</span>
        <span class="tag">Copilot</span>
        <span class="tag">VS Code Extension</span>
        <span class="tag">TypeScript</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/jira-release-orchestration/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2026</div>
        <h2 class="project-card-title">Self-Service Release Orchestration</h2>
        <div class="project-card-phase">DevOps / Release Architect</div>
      </div>
      <p class="project-card-description">
        Eliminated release bottlenecks by engineering a self-service deployment pipeline integrating Jira, ServiceNow, and uDeploy.
      </p>
      <div class="project-card-tags">
        <span class="tag">Jira</span>
        <span class="tag">ServiceNow</span>
        <span class="tag">uDeploy</span>
        <span class="tag">DevOps</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/jenkins-to-cloudbees/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2024</div>
        <h2 class="project-card-title">Jenkins to CloudBees CI Migration</h2>
        <div class="project-card-phase">DevOps / Release Architect</div>
      </div>
      <p class="project-card-description">
        Idempotent migration of 250+ Jenkins pipelines to CloudBees CI using a declarative JSON-driven Pipeline Generator, completed in just 1 week.
      </p>
      <div class="project-card-tags">
        <span class="tag">Jenkins</span>
        <span class="tag">CloudBees CI</span>
        <span class="tag">Groovy</span>
        <span class="tag">JSON</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/pipeline-factory/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2023</div>
        <h2 class="project-card-title">Pipeline Factory: Standardized DevOps</h2>
        <div class="project-card-phase">DevOps / Release Architect</div>
      </div>
      <p class="project-card-description">
        Designed a metadata-driven Jenkins Pipeline Factory that eliminates Jenkinsfile duplication by dynamically orchestrating isolated, parallel polyglot builds.
      </p>
      <div class="project-card-tags">
        <span class="tag">Jenkins</span>
        <span class="tag">Docker</span>
        <span class="tag">Groovy</span>
        <span class="tag">CI/CD</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/gated-ci-cd-pipelines/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2023</div>
        <h2 class="project-card-title">Gated CI/CD & Testing Culture</h2>
        <div class="project-card-phase">DevOps / Release Architect</div>
      </div>
      <p class="project-card-description">
        Enforced strict SonarQube quality gates across all pipelines and cultivated a testing culture that took automated unit test coverage from near zero to over 80%.
      </p>
      <div class="project-card-tags">
        <span class="tag">SonarQube</span>
        <span class="tag">TDD</span>
        <span class="tag">Bash Testing</span>
        <span class="tag">Quality Gates</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/observability-secret-management/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2023</div>
        <h2 class="project-card-title">Enterprise Observability & Security</h2>
        <div class="project-card-phase">DevOps / Release Architect</div>
      </div>
      <p class="project-card-description">
        Engineered standardized Python and Java SDKs to integrate applications with Splunk for centralized logging and HashiCorp Vault for dynamic secret management.
      </p>
      <div class="project-card-tags">
        <span class="tag">Splunk</span>
        <span class="tag">HashiCorp Vault</span>
        <span class="tag">Python</span>
        <span class="tag">Java</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/control-m-to-airflow/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2019</div>
        <h2 class="project-card-title">Control-M to Apache Airflow Migration</h2>
        <div class="project-card-phase">DevOps / Data Engineer</div>
      </div>
      <p class="project-card-description">
        Migrated 500+ legacy batch jobs from Control-M to Apache Airflow on Kubernetes, reducing release cycle from 2 weeks to 3 days and eliminating 60% of manual operations.
      </p>
      <div class="project-card-tags">
        <span class="tag">Airflow</span>
        <span class="tag">Kubernetes</span>
        <span class="tag">Python</span>
        <span class="tag">GitLab CI/CD</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/on-premise-to-cloud/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2018</div>
        <h2 class="project-card-title">Event-Driven AWS Migration</h2>
        <div class="project-card-phase">Cloud / Data Architect</div>
      </div>
      <p class="project-card-description">
        Architected a cost-optimized, fully event-driven big data pipeline using S3, Lambda, Step Functions, and ephemeral EMR clusters before the era of EMR Serverless.
      </p>
      <div class="project-card-tags">
        <span class="tag">AWS</span>
        <span class="tag">Lambda</span>
        <span class="tag">Step Functions</span>
        <span class="tag">EMR</span>
        <span class="tag">Terraform</span>
        <span class="tag">GitLab CI</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/generic-etl-process/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2010</div>
        <h2 class="project-card-title">Generic Metadata-Driven ETL Framework</h2>
        <div class="project-card-phase">Data Engineer</div>
      </div>
      <p class="project-card-description">
        Designed a generic, metadata-driven bash ETL framework that eliminated redundant script creation, introduced automated stateful recovery checkpoints, and centralized custom SQL transformations.
      </p>
      <div class="project-card-tags">
        <span class="tag">Bash</span>
        <span class="tag">SQL</span>
        <span class="tag">Data Architecture</span>
        <span class="tag">ETL</span>
      </div>
    </a>
    <a href="/my_portfolio/projects/enterprise-tokenization-ui/" class="project-card">
      <div class="project-card-header">
        <div class="project-card-year">2007</div>
        <h2 class="project-card-title">Enterprise Tokenization UI</h2>
        <div class="project-card-phase">ASP.NET Developer</div>
      </div>
      <p class="project-card-description">
        Built a highly reusable, component-driven ASP.NET interface for business analysts to securely tokenize and detokenize sensitive warehouse data across multiple domains without code duplication.
      </p>
      <div class="project-card-tags">
        <span class="tag">ASP.NET</span>
        <span class="tag">C#</span>
        <span class="tag">Security</span>
        <span class="tag">UI/UX</span>
      </div>
    </a>

    <div class="project-card" style="opacity: 0.5; pointer-events: none;">
      <div class="project-card-header">
        <div class="project-card-year">Coming Soon</div>
        <h2 class="project-card-title">Cloud-Native Microservices Platform</h2>
        <div class="project-card-phase">Solutions Architect</div>
      </div>
      <p class="project-card-description">
        Designed and built a microservices platform with FastAPI, EKS, and ArgoCD...
      </p>
      <div class="project-card-tags">
        <span class="tag">FastAPI</span>
        <span class="tag">EKS</span>
        <span class="tag">Python</span>
      </div>
    </div>

    <div class="project-card" style="opacity: 0.5; pointer-events: none;">
      <div class="project-card-header">
        <div class="project-card-year">Coming Soon</div>
        <h2 class="project-card-title">Agent Development Kit (ADK)</h2>
        <div class="project-card-phase">AI Engineer</div>
      </div>
      <p class="project-card-description">
        Built a framework-agnostic agent platform where one YAML runs agents on LangChain, LangGraph, CrewAI...
      </p>
      <div class="project-card-tags">
        <span class="tag">LLM Agents</span>
        <span class="tag">Python</span>
        <span class="tag">FastAPI</span>
      </div>
    </div>
  </div>
</BaseLayout>
