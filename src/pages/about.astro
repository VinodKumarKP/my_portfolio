---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <style>
    .about-container {
      max-width: 900px;
      margin: 0 auto;
      padding-bottom: 4rem;
    }

    .profile-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-lg);
      margin-bottom: 4rem;
      padding: 3rem;
      background: var(--color-bg-light);
      border: 1px solid var(--color-border);
      border-radius: 24px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
      position: relative;
      overflow: hidden;
    }

    @media (prefers-color-scheme: dark) {
      .profile-header {
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      }
    }

    .profile-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, var(--color-accent), #8a2be2, var(--color-accent));
      background-size: 200% 100%;
      animation: gradient-shift 5s ease infinite;
    }

    @keyframes gradient-shift {
      0% { background-position: 100% 0; }
      50% { background-position: 0 0; }
      100% { background-position: 100% 0; }
    }

    @media (min-width: 768px) {
      .profile-header {
        flex-direction: row;
        text-align: left;
        padding: 3rem 4rem;
      }
    }

    .profile-image {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--color-bg);
      box-shadow: 0 10px 25px rgba(0, 102, 204, 0.3);
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      margin-bottom: 0;
    }
    
    .profile-header:hover .profile-image {
      transform: scale(1.05) rotate(-2deg);
      box-shadow: 0 15px 35px rgba(138, 43, 226, 0.4);
    }

    .profile-title h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2.75rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, var(--color-text) 0%, var(--color-text-light) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .profile-title h2 {
      margin: 0 0 1.5rem 0;
      font-size: 1.25rem;
      color: var(--color-text-light);
      font-weight: 500;
    }

    .about-card {
      padding: 2.5rem;
      background: var(--color-bg-light);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      margin-bottom: 2.5rem;
    }

    @media (prefers-color-scheme: dark) {
      .about-card {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
      }
    }

    .about-card h3 {
      font-size: 1.6rem;
      margin-bottom: 1.5rem;
      color: var(--color-accent);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .about-card p {
      font-size: 1.1rem;
      line-height: 1.8;
      color: var(--color-text-light);
      margin-bottom: 1.5rem;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .skill-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .skill-list li {
      margin-bottom: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-text-light);
      font-size: 1.05rem;
    }

    .skill-list li::before {
      content: '→';
      color: var(--color-accent);
      font-weight: bold;
    }

    .cert-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .cert-tag {
      padding: 8px 16px;
      background: rgba(0, 102, 204, 0.05);
      border: 1px solid rgba(0, 102, 204, 0.2);
      border-radius: 20px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-accent);
    }

    .links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    
    @media (min-width: 768px) {
      .links {
        justify-content: flex-start;
      }
    }

    .links a {
      display: inline-flex;
      align-items: center;
      padding: 0.75rem 1.5rem;
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      color: white;
      text-decoration: none;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(138, 43, 226, 0.2);
    }

    .links a:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(138, 43, 226, 0.4);
    }
    
    .links a.secondary {
      background: transparent;
      color: var(--color-text);
      border: 1px solid var(--color-border);
      box-shadow: none;
    }
    
    .links a.secondary:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      background: rgba(0, 102, 204, 0.05);
    }
  </style>

  <div class="about-container">
    <div class="profile-header">
      <img src="/my_portfolio/my_image.jpeg" alt="Vinod Kumar" class="profile-image" />
      <div class="profile-title">
        <h1>Vinod Kumar</h1>
        <h2>Solutions Architect & AI Engineer</h2>
        <div class="links">
          <a href="https://linkedin.com/in/vinod-kumar-k-p/" target="_blank">Connect on LinkedIn</a>
          <a href="https://github.com/vinodkumarkp" target="_blank" class="secondary">View GitHub</a>
        </div>
      </div>
    </div>

    <div class="about-card">
      <h3>Professional Journey</h3>
      <p>
        I'm a Solutions Architect and AI Engineer with 18+ years of experience building data pipelines,
        cloud infrastructure, and AI systems at scale. My journey started in data engineering and has evolved
        through cloud architecture, DevOps, and now into leading GenAI initiatives.
      </p>
      <p>
        I am passionate about solving complex architectural challenges and mentoring teams to deliver
        systems that scale. I believe in building systems that are not just technically sound but also
        maintainable, observable, and secure. Recently, I've been deeply invested in the AI/GenAI space—building agent platforms, RAG systems, and helping organizations adopt AI practices safely. I even earned the "AI Champion" award for driving AI adoption across application teams.
      </p>
    </div>

    <div class="about-card">
      <h3>Core Expertise</h3>
      <div class="skills-grid">
        <ul class="skill-list">
          <li>Enterprise Cloud Architecture (AWS, Azure)</li>
          <li>Event-driven & Batch Data Pipelines</li>
          <li>GenAI, LLM Agents & RAG Systems</li>
        </ul>
        <ul class="skill-list">
          <li>DevOps & Release Orchestration</li>
          <li>Microservices & API-first design</li>
          <li>Infrastructure as Code (Terraform)</li>
        </ul>
      </div>
    </div>

    <div class="about-card">
      <h3>Leadership & Mentorship</h3>
      <p>
        I believe that architecture is only as successful as the teams executing it. I have extensive experience leading and elevating cross-functional application teams (8-15+ engineers) across mixed experience levels. 
      </p>
      <div class="skills-grid">
        <ul class="skill-list">
          <li><strong>AI/GenAI Workshops:</strong> Designed and conducted enterprise-wide presentations teaching teams how to build, evaluate, and govern LLM agents using the Agent Development Kit.</li>
          <li><strong>DevOps Modernization:</strong> Led hands-on workshops instructing application teams on CI/CD best practices, writing automated unit tests, and resolving SonarQube quality gates.</li>
        </ul>
        <ul class="skill-list">
          <li><strong>Executive Communication:</strong> Translated complex architectural decisions (ADRs) and AI governance strategies into clear, actionable presentations for non-technical stakeholders.</li>
        </ul>
      </div>
    </div>

    <div class="about-card">
      <h3>Certifications</h3>
      <div class="cert-tags">
        <span class="cert-tag">AWS Certified Solutions Architect</span>
        <span class="cert-tag">AWS Certified DevOps Engineer</span>
        <span class="cert-tag">Azure Certified Architect</span>
        <span class="cert-tag">CKA & CKAD (Kubernetes)</span>
        <span class="cert-tag">Claude Certified Associate Architect</span>
        <span class="cert-tag">Docker Certified Associate</span>
        <span class="cert-tag">Apache Airflow Certified</span>
        <span class="cert-tag">Databricks Certified</span>
        <span class="cert-tag">SAFe Scrum Master</span>
      </div>
    </div>

  </div>
</BaseLayout>
